{
  "apphosting": [
    {
      "backendId": "arcos",
      "rootDir": "apps/web",
      "ignore": [
        "node_modules",
        ".git",
        ".superpowers",
        ".claude",
        ".next",
        ".env.local",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "packages/contracts/out",
        "packages/contracts/cache",
        "packages/contracts/broadcast"
      ]
    },
    {
      "backendId": "arcos-testnet",
      "rootDir": "apps/web",
      "ignore": [
        "node_modules",
        ".git",
        ".superpowers",
        ".claude",
        ".next",
        ".env.local",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "packages/contracts/out",
        "packages/contracts/cache",
        "packages/contracts/broadcast"
      ]
    }
  ],
  "emulators": {
    "firestore": {
      "host": "127.0.0.1",
      "port": 8181
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  },
  "firestore": [
    {
      "database": "arcos",
      "rules": "firestore/arcos.rules",
      "indexes": "firestore/arcos.indexes.json"
    }
  ],
  "hosting": {
    "site": "arcos",
    "public": "firebase-hosting",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "https://4rcos.com/",
        "type": 301
      },
      {
        "source": "/:path*",
        "destination": "https://4rcos.com/:path*",
        "type": 301
      }
    ]
  }
}
