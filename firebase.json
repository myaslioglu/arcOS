{
  "apphosting": [
    {
      "backendId": "arcos",
      "rootDir": "apps/web",
      "ignore": [
        "node_modules",
        ".git",
        ".superpowers",
        ".claude",
        ".next",
        ".env.local",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "packages/contracts/out",
        "packages/contracts/cache",
        "packages/contracts/broadcast"
      ]
    }
  ],
  "hosting": {
    "site": "arcos",
    "public": "firebase-hosting",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "https://4rcos.com/",
        "type": 301
      },
      {
        "source": "/:path*",
        "destination": "https://4rcos.com/:path*",
        "type": 301
      }
    ]
  }
}
