# "mainnet" switches the whole app to Arc mainnet. Anything else = testnet.
NEXT_PUBLIC_ARC_NETWORK=testnet
# Public address that receives Swap/Bridge platform fees (Task 20).
NEXT_PUBLIC_FEE_RECIPIENT=
# The app's public origin (e.g. https://os.arc.io), no trailing slash. Sets metadataBase so
# og:image and other URL-based metadata resolve to an absolute URL instead of failing to embed.
NEXT_PUBLIC_SITE_URL=
# Server-only, never NEXT_PUBLIC_: a Blockscout PRO API key (https://dev.blockscout.com). Arc mainnet's public
# explorer refuses server requests, so with this set the server-built Inspector pages (/t/<address>, /badge,
# /api/inspect) read explorer data from api.blockscout.com instead. Leave it empty for local development.
BLOCKSCOUT_API_KEY=
